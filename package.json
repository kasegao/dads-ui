{
  "name": "dads-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "styled-system"
  ],
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preset": {
      "types": "./dist/types/preset/index.d.ts",
      "default": "./dist/preset.js"
    },
    "./styles.css": "./dist/styles.css",
    "./panda/*": "./dist/panda/*",
    "./css": {
      "types": "./styled-system/css/index.d.ts",
      "default": "./styled-system/css/index.js"
    },
    "./css/*": {
      "types": "./styled-system/css/*.d.ts",
      "default": "./styled-system/css/*.js"
    },
    "./patterns": {
      "types": "./styled-system/patterns/index.d.ts",
      "default": "./styled-system/patterns/index.js"
    },
    "./patterns/*": {
      "types": "./styled-system/patterns/*.d.ts",
      "default": "./styled-system/patterns/*.js"
    },
    "./jsx": {
      "types": "./styled-system/jsx/index.d.ts",
      "default": "./styled-system/jsx/index.js"
    },
    "./jsx/*": {
      "types": "./styled-system/jsx/*.d.ts",
      "default": "./styled-system/jsx/*.js"
    },
    "./tokens": {
      "types": "./styled-system/tokens/index.d.ts",
      "default": "./styled-system/tokens/index.js"
    },
    "./helpers": {
      "types": "./styled-system/helpers.d.ts",
      "default": "./styled-system/helpers.js"
    },
    "./types": {
      "types": "./styled-system/types/index.d.ts"
    }
  },
  "scripts": {
    "prepare": "panda codegen",
    "tokens": "node scripts/gen-tokens.mjs",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "build": "panda codegen && vite build && panda cssgen -c panda.build.config.ts --outfile dist/styles.css && panda lib -c panda.build.config.ts --files \"./**/*.js\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest --run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@pandacss/dev": "^2.0.0",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@ark-ui/react": "5.40.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@digital-go-jp/design-tokens": "2.1.0",
    "@pandacss/dev": "2.6.0",
    "@pandacss/preset-base": "2.6.0",
    "@pandacss/vite": "2.6.0",
    "@storybook/addon-a11y": "10.6.9",
    "@storybook/addon-docs": "10.6.9",
    "@storybook/addon-vitest": "10.6.9",
    "@storybook/react-vite": "10.6.9",
    "@types/node": "26.6.11",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/browser-playwright": "5.1.2",
    "playwright": "1.65.1",
    "postcss": "8.5.33",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.9",
    "typescript": "7.0.2",
    "vite": "8.4.0",
    "vitest": "5.1.2",
    "vitest-browser-react": "2.3.0"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@parcel/watcher"
    ]
  },
  "peerDependenciesMeta": {
    "@pandacss/dev": {
      "optional": true
    }
  }
}
